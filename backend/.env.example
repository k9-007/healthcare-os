# --- Sarvam ---
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxx
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Telephony: "simulation" (default, zero-infra) or "twilio" ---
TELEPHONY_MODE=simulation
# Account SID (AC…) is required ONLY for calls our backend places over the REST
# API and for downloading <Record> recordings. The Twilio Console's
# "Make a test call" widget dials with its own session and only needs a public
# TwiML URL, so a live conversational test works without this value.
TWILIO_ACCOUNT_SID=
# Optional SK… API key; TWILIO_AUTH_TOKEN is then its secret
TWILIO_API_KEY_SID=
TWILIO_AUTH_TOKEN=
# The trial number the account calls from, e.g. +17372212163
TWILIO_FROM_NUMBER=
# Public URL reachable by Twilio (e.g. `ngrok http 8000`). Media Streams derive
# their wss:// URL from this, so it MUST be https in any real call.
PUBLIC_BASE_URL=http://localhost:8000

# --- Real-time voice ---
# "stream": VAD-driven conversation over Twilio Media Streams
# "classic": the original <Play> + <Record> single-turn IVR
VOICE_MODE=stream
# Silero probability above which a 20ms frame counts as speech
VAD_SPEECH_THRESHOLD=0.5
# Sustained speech before we accept that the patient started talking
VAD_START_MS=150
# Trailing silence that ends a turn — the single biggest "feel" knob
VAD_SILENCE_MS=600
# Hard stop so a monologue still gets processed
VAD_MAX_UTTERANCE_MS=15000
# Speech over the nurse before we stop her mid-sentence
VAD_BARGE_IN_MS=400
# Silence after a question before re-prompting
VOICE_NO_SPEECH_MS=7000

# --- Storage ---
DATABASE_URL=sqlite:///./data/healthcareos.db
DATA_DIR=./data

# --- Scheduler ---
SCHED_TICK_SECONDS=60
# horizon (hours) of ScheduledCall slots materialized ahead of time
SCHEDULE_HORIZON_HOURS=48
# demo mode: interpret follow-up ask_after_days as minutes
TIME_SCALE_DEMO=false

# --- Misc ---
DEFAULT_LANGUAGE=hi-IN
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
