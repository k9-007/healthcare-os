# --- Sarvam ---
# Required for STT/TTS/translate and prescription Vision (doc-digitization).
# Without it, prescription parse returns 503; voice falls back to simulation.
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxx
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Telephony: "simulation" (default, zero-infra) or "plivo" ---
TELEPHONY_MODE=simulation
# Auth ID and token from Plivo Console → Account → Keys & Credentials
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# A voice-enabled Plivo number this account owns, e.g. +912269983412
PLIVO_FROM_NUMBER=
# Public https URL reachable by Plivo (e.g. `cloudflared tunnel --url
# http://localhost:8000`). Plivo fetches the answer XML AND the <Play> audio
# from it, so a real call is impossible without one.
PUBLIC_BASE_URL=http://localhost:8000

# --- Real-time voice ---
# "stream": Silero VAD over Plivo Audio Stream (phone) + browser WS — barge-in
# "classic": <Play> + <Record> with a fixed silence window (no barge-in)
VOICE_MODE=stream
# Silero probability above which a 20ms frame counts as speech
VAD_SPEECH_THRESHOLD=0.5
# Sustained speech before we accept that the patient started talking
VAD_START_MS=150
# Trailing silence that ends a turn — main "feel" knob (ms)
VAD_SILENCE_MS=500
# Hard stop so a monologue still gets processed
VAD_MAX_UTTERANCE_MS=15000
# Speech over the nurse before we stop her mid-sentence
VAD_BARGE_IN_MS=700
# Silence after a question before re-prompting
VOICE_NO_SPEECH_MS=7000

# --- Storage ---
DATABASE_URL=sqlite:///./data/healthcareos.db
DATA_DIR=./data

# --- Scheduler ---
SCHED_TICK_SECONDS=60
# horizon (hours) of ScheduledCall slots materialized ahead of time
SCHEDULE_HORIZON_HOURS=48
# demo mode: interpret follow-up ask_after_days as minutes
TIME_SCALE_DEMO=false

# --- Misc ---
DEFAULT_LANGUAGE=hi-IN
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Transcribe over Sarvam WebSocket instead of uploading each finished
# utterance. Measured 570-1137ms faster per turn; batch is the fallback.
STT_STREAMING=false
