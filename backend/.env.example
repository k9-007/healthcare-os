# --- Sarvam ---
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxx
SARVAM_BASE_URL=https://api.sarvam.ai

# --- Telephony: "simulation" (default, zero-infra) or "plivo" (real PSTN) ---
TELEPHONY_MODE=simulation
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
# Public HTTPS URL reachable by Plivo webhooks + <Play> audio (e.g. ngrok)
PUBLIC_BASE_URL=http://localhost:8000

# --- Storage ---
DATABASE_URL=sqlite:///./data/healthcareos.db
DATA_DIR=./data

# --- Scheduler ---
SCHED_TICK_SECONDS=60
# horizon (hours) of ScheduledCall slots materialized ahead of time
SCHEDULE_HORIZON_HOURS=48
# demo mode: interpret follow-up ask_after_days as minutes
TIME_SCALE_DEMO=false

# --- Misc ---
DEFAULT_LANGUAGE=hi-IN
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
